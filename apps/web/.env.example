# Frontend public environment variables (apps/web).
# This file is a documentation template only.
# Never commit real secrets. The Next.js app must not receive server-side secrets (AGENTS.md section 8).

# Public API base URL used by the frontend API client.
# Only variables prefixed with NEXT_PUBLIC_ are inlined into the client bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
