# Backend environment variables (apps/api).
# This file is a documentation template only.
# Never commit real credentials. Copy to .env for local development and fill in real values.

# PostgreSQL connection string used by Prisma.
# Required for DB-dependent startup and tests.
DATABASE_URL=postgresql://socialops:socialops_dev@localhost:5432/socialops

# Redis connection string used by the Redis module.
# Required for Redis-dependent startup and tests.
REDIS_URL=redis://localhost:6379

# JWT access token signing secret.
# Required for access-token issuance and verification (AGENTS.md section 8).
# Use a strong random value in any non-dev environment; never commit it.
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret

# JWT refresh token signing secret.
# Required for refresh-token issuance and verification.
JWT_REFRESH_SECRET=replace-with-a-strong-random-secret

# Access token lifetime in seconds.
# Default used in code when absent: 900
JWT_ACCESS_TTL=900

# Refresh token lifetime in seconds.
# Default used in code when absent: 604800
JWT_REFRESH_TTL=604800

# Node environment.
# Affects dev-only behavior in this codebase.
NODE_ENV=development

# Public web application base URL used for generated links/redirects.
PUBLIC_WEB_URL=http://localhost:3000

# Dev-only toggle for automatic email verification at registration.
# Should remain OFF outside local/dev contexts.
AUTH_DEV_AUTO_VERIFY_REGISTER=false

# Dev-only toggle for boot-artifact logging behavior.
BOOT_ARTIFACTS_ALLOWED=false

# ---------------------------------------------------------------------------
# AI Employee Fleet (LLM provider) - Phase 4
# ---------------------------------------------------------------------------
# Provider: mock | openai | anthropic. 'mock' (the default) needs no key and is
# used for local development and CI; real providers require their API key.
LLM_PROVIDER=mock

# Provider API keys. NEVER commit real values (AGENTS.md section 8).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model + tuning (optional). Examples:
#   OpenAI    -> gpt-4o-mini
#   Anthropic -> claude-3-5-haiku-latest
LLM_MODEL=
LLM_MAX_TOKENS=
LLM_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# S3-compatible object storage (RawData media) - approved AGENTS.md §13 override
# ---------------------------------------------------------------------------
# Region of the (private) bucket. Required to mint presigned URLs.
AWS_REGION=us-east-1

# AWS credentials used ONLY server-side to sign presigned PUT URLs.
# NEVER commit real values (AGENTS.md section 8). CI runs without storage
# configured: the app boots, and upload-url requests answer 503 until set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Private bucket that holds raw-data media. Objects are read back only via
# short-lived signed requests; the bucket must never be public.
S3_RAW_DATA_BUCKET=socialops-raw-data-dev

# Presigned URL lifetime in seconds (bounded 60..3600 in code).
# Default when absent: 900 (15 minutes).
S3_PRESIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# OAuth token storage + platform credentials (Decision 013; AGENTS.md §13
# override). Native node:crypto AES-256-GCM envelope encryption - no KMS.
# ---------------------------------------------------------------------------
# KEK generation (32 random bytes, base64). NEVER commit real values (§8).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Version of the KEK that wraps NEW per-credential DEKs. Rotation: add
# TOKEN_KEK_V2 and raise this to 2 - existing rows stay readable.
TOKEN_KEK_ACTIVE_VERSION=1
TOKEN_KEK_V1=

# Dedicated secret for signing the OAuth CSRF state (>= 16 chars). Distinct
# from every JWT secret by design.
OAUTH_STATE_SECRET=replace-with-a-strong-random-secret

# Platform OAuth client credentials. Leave blank to disable a platform's
# connect flow (it answers 503 until configured).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Public API origin the platforms redirect back to. Defaults to
# http://localhost:${PORT} when absent. The registered redirect URI is
# {OAUTH_REDIRECT_BASE_URL}/api/social-accounts/callback/{PLATFORM}
OAUTH_REDIRECT_BASE_URL=http://localhost:4000
