// SocialOps Stage B database foundation schema.
//
// Governance (AGENTS.md):
//   - Section 6: Organization is the top-level tenant / isolation boundary.
//     A Workspace belongs to exactly one Organization; an Organization may
//     have many Workspaces. A User has NO personal/default Workspace -
//     access is always mediated through OrganizationMembership.
//   - Section 7: Roles (Owner, Admin, Member, Viewer) are attached to the
//     OrganizationMembership, never directly to User or Workspace.
//   - Section 8: RefreshToken stores only a hash of the token.
//   - Section 13: The bootstrap foundation plus the human-approved Phase 2
//     Client Module V1 domain. Other deferred modules (content, task,
//     publishing, analytics, OAuth, S3) are deliberately not modeled.
//
// Connection: Prisma reads DATABASE_URL from the environment (required by
// the approved Stage B plan - no connection logic lives in code).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The four locked RBAC roles (AGENTS.md section 7). No other role may be
/// added without explicit human approval.
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Account type selected on the public registration page
/// (AGENTS.md §17.1). Exactly two choices; employee is intentionally
/// NOT here — employee registration is a separate future flow.
enum AccountType {
  SERVICE_PROVIDER
  INDIVIDUAL_BUSINESS
}

/// Client Module V1 (Phase 2, human-approved under AGENTS.md §13).
///
/// Governance notes:
///   - Direct User -> Client ownership (binding) is established ONLY through
///     the controlled onboarding/acceptance flow; an Agency creating a
///     Client NEVER becomes the owner.
///   - ClientStatus is EXACTLY ACTIVE | INACTIVE | SUSPENDED. Onboarding
///     lifecycle is tracked separately via ClientOnboardingStatus.
///   - SOCIALOPS_ADMIN (User-level global authority) is separate from the
///     organization-scoped OWNER/ADMIN/MEMBER/VIEWER roles.
///   - No new RBAC roles: Dedicated Manager / Content Team are business
///     concepts only and are NOT modeled here.
enum ClientType {
  INDIVIDUAL
  BUSINESS
}

/// Operational status of a Client. Exactly three values (approved); the
/// onboarding lifecycle is NOT part of this enum (see
/// ClientOnboardingStatus).
enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Onboarding lifecycle of a Client. Client-facing operational/self-service
/// access requires onboarding status ACTIVE; PENDING clients are not
/// operationally usable by the Client account.
enum ClientOnboardingStatus {
  PENDING
  ACTIVE
}

/// Lifecycle of a Client <-> Agency relationship. A Client may have at most
/// one ACTIVE relationship at a time (enforced in service logic; no silent
/// replacement - explicit termination first).
enum AgencyRelationshipStatus {
  PENDING_REQUEST
  PENDING_INVITATION
  ACTIVE
  TERMINATED
}

/// Status of a Client field-change request (cooldown + verification).
enum FieldChangeRequestStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  EXPIRED
}

/// Named Client fields subject to change-control / cooldown enforcement.
/// Cooldown periods are defined in the application layer
/// (src/clients/constants/field-cooldowns.ts) using the exact approved table.
enum ClientField {
  NAME
  DIRECT_EMAIL
  DIRECT_MOBILE
  PRIMARY_CONTACT_NAME
  PRIMARY_CONTACT_MOBILE
  WEBSITE
  ADDRESS
  DESCRIPTION
  INDUSTRY
  CLIENT_TYPE
  LOGO_AVATAR
  NOTES
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  // Nullable until the authentication foundation stage introduces credentials;
  // Stage B creates no users itself.
  passwordHash  String?
  displayName   String?
  // AGENTS.md §17.2 registration fields. Nullable so pre-migration rows
  // remain valid without a backfill.
  fullName      String?
  phone         String?
  accountType   AccountType?
  // AGENTS.md §17.2: new users are INACTIVE until email verification.
  // The default applies to future inserts only; existing rows keep
  // their current value (see 20260903220000 migration note).
  isActive      Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   OrganizationMembership[]
  refreshTokens RefreshToken[]
  verificationTokens EmailVerificationToken[]
  mobileVerificationRequests MobileVerificationToken[] @relation("MobileVerificationRequester")

  // Employee Module V1 (Phase 1): 1:1 employee-profile extension. At most
  // one profile per user (UNIQUE userId on EmployeeProfile).
  employeeProfile EmployeeProfile?

  // Client Module V1: direct User -> Client ownership (binding). Set only
  // through the controlled onboarding/acceptance flow - never at Agency
  // creation and never via normal Client profile APIs.
  ownedClients Client[] @relation("ClientOwner")

  // SOCIALOPS_ADMIN: user-level GLOBAL authority (Option A), independent of
  // organization membership. Separate from OWNER/ADMIN/MEMBER/VIEWER. An
  // Agency ADMIN never implies this flag. Powers are limited to the approved
  // Client V1 platform operations (Client status management and Agency
  // discovery approval). This is not an organization-scoped role.
  isSocialOpsAdmin Boolean  @default(false)
  socialOpsAdminGrantedAt DateTime?
  socialOpsAdminGrantedById String? @db.Uuid
  socialOpsAdminRevokedAt DateTime?

  // Client Operations V1 (metadata only): audit-only creator/actor links.
  // None of these confer ownership or authorization - ownership lives on
  // SocialAccount/Content/RawData via their non-nullable clientId.
  socialAccountsCreated   SocialAccount[]      @relation("SocialAccountCreator")
  contentsCreated         Content[]            @relation("ContentCreator")
  contentsUpdated         Content[]            @relation("ContentUpdater")
  contentsFinalConfirmed  Content[]            @relation("ContentFinalConfirmer")
  contentRevisionsCreated ContentRevision[]    @relation("ContentRevisionCreator")
  contentStatusActed      ContentStatusEvent[] @relation("ContentStatusActor")
  rawDataCaptured         RawData[]            @relation("RawDataCapturer")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Client Module V1: Agency discovery. An Agency becomes discoverable only
  // when BOTH opt-in and SOCIALOPS_ADMIN approval are present.
  discoveryOptIn            Boolean   @default(false)
  discoveryApprovedAt       DateTime?
  discoveryApprovedByUserId String?   @db.Uuid

  workspaces  Workspace[]
  memberships OrganizationMembership[]
  // Agency-side Client relationships (the Organization represents the
  // Agency / Service Provider tenant; Organization is NOT the Client).
  clientRelationships ClientAgencyRelationship[]

  @@index([discoveryOptIn])
}

model Workspace {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  slug           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Slugs are namespaced per tenant, not globally.
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  // Least privilege / deny by default (AGENTS.md section 7): the default is
  // the most restrictive role; anything broader must be granted explicitly.
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // A user holds at most one role per organization; different roles in
  // different organizations are supported.
  @@unique([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  // Only the hash is ever stored; raw tokens must never hit the database
  // (AGENTS.md section 8).
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  // Only the SHA-256 hash is ever stored; the raw token never touches
  // the database (AGENTS.md section 8).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Client Module V1 domain (Phase 2, human-approved under AGENTS.md §13).
// ---------------------------------------------------------------------------

/// A Client is a first-class entity: the person/business whose social-media
/// or account-management service is being handled. The Client account always
/// belongs to the Client regardless of who created or registered it.
///
/// Ownership (binding) is a direct `User -> Client` relation established ONLY
/// through the controlled onboarding/acceptance flow. A Client may be created
/// by an Agency (unbound until an invited user accepts) or via self-
/// registration (bound to the registering user on onboarding completion).
///
/// No permanent deletion is implemented: Clients are never hard-deleted.
model Client {
  id            String                @id @default(uuid()) @db.Uuid
  // The Client's owner account. NULL until the controlled onboarding binds
  // a User. An Agency creator NEVER becomes the owner.
  ownerUserId   String?               @db.Uuid
  type          ClientType
  name          String
  description   String?
  // Metadata only: no file storage / S3 / image processing for Logo/Avatar.
  logoUrl       String?
  directEmail   String
  directPhone   String
  primaryContactName  String?
  primaryContactPhone String?
  website       String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  // Predefined list + "Other", validated at the application layer.
  industry      String?
  // Operational status - EXACTLY ACTIVE | INACTIVE | SUSPENDED.
  status        ClientStatus          @default(ACTIVE)
  statusReason  String?
  statusChangedAt DateTime?
  // Onboarding lifecycle is separate from operational status. Client-facing
  // operational/self-service access requires onboardingStatus = ACTIVE.
  onboardingStatus    ClientOnboardingStatus @default(PENDING)
  onboardingCompletedAt DateTime?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  ownerUser     User?                 @relation("ClientOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  relationships ClientAgencyRelationship[]
  invitations   ClientInvitation[]
  fieldChanges  ClientFieldChange[]
  events        ClientEvent[]
  mobileVerificationTokens MobileVerificationToken[]

  // Client Operations V1 (metadata only). Every child row is scoped by its
  // non-nullable clientId; these relations exist for query/joins only.
  socialAccounts       SocialAccount[]
  contents             Content[]
  contentRevisions     ContentRevision[]
  contentStatusEvents  ContentStatusEvent[]
  rawData              RawData[]

  @@index([ownerUserId])
  @@index([status])
  @@index([onboardingStatus])
}

/// History of a Client <-> Agency relationship. At most one ACTIVE
/// relationship per Client (enforced in service logic; explicit termination
/// first, no silent replacement). The `organizationId` references the Agency
/// (Organization represents the Agency / Service Provider tenant - Option A).
model ClientAgencyRelationship {
  id             String                @id @default(uuid()) @db.Uuid
  clientId       String                @db.Uuid
  organizationId String                @db.Uuid
  status         AgencyRelationshipStatus
  initiatedBy    ClientAgencyFlow      // CLIENT | AGENCY
  startedAt      DateTime?
  terminatedAt   DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /// Enforces the ONE ACTIVE Agency invariant at the database level.
  /// A partial unique index ensures a clientId can have at most one
  /// ACTIVE ClientAgencyRelationship, preventing silent replacement.
  /// See migration 20260916000000_enforce_one_active_agency for the raw SQL.
  @@index([clientId, status], name: "ClientAgencyRelationship_clientId_status_idx")
  @@index([organizationId, status])
}

/// Who initiated a Client <-> Agency relationship flow.
enum ClientAgencyFlow {
  CLIENT
  AGENCY
}

/// Invitation/acceptance token for Client onboarding (Agency-created path).
/// Mirrors the EmailVerificationToken security pattern: only the SHA-256 hash
/// is ever stored; single-use with expiry.
model ClientInvitation {
  id        String    @id @default(uuid()) @db.Uuid
  clientId  String    @db.Uuid
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([email])
}

/// A requested Client profile field change, subject to the exact approved
/// cooldown table and (for NAME / DIRECT_EMAIL / DIRECT_MOBILE) the locked
/// re-authentication + verification controls.
model ClientFieldChange {
  id                String                @id @default(uuid()) @db.Uuid
  clientId          String                @db.Uuid
  field             ClientField
  newValue          String?
  status            FieldChangeRequestStatus @default(PENDING_VERIFICATION)
  requestedByUserId String?               @db.Uuid
  requestedAt       DateTime              @default(now())
  approvedAt        DateTime?
  appliedAt         DateTime?
  rejectedReason    String?
  // Security-controlled DIRECT_EMAIL / DIRECT_MOBILE changes (locked rule):
  // re-authentication plus verification of the NEW value. Hash-only token
  // storage (mirrors EmailVerificationToken / MobileVerificationToken);
  // single-use + expiry enforced in the service layer. NULL for fields
  // that require no second verification step (e.g. NAME: re-auth only).
  verificationTokenHash String?           @unique
  verificationExpiresAt DateTime?
  verifiedAt            DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, field])
  @@index([clientId, status])
}

/// Immutable audit trail for Client Module V1 operations (AGENTS.md §8:
/// all important operations are auditable). Insert-only.
model ClientEvent {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  details     Json?
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

/// Mobile verification token (Client Module V1, approved decision D3).
///
/// A dedicated, semantically separate model from EmailVerificationToken:
/// mobile verification is a Client-scoped concern (onboarding verification
/// and DIRECT_MOBILE field changes), and the Client record exists before a
/// User binding does.
///
/// Security properties (mirroring EmailVerificationToken):
///   - Only the SHA-256 hash is ever stored; the raw token never touches
///     the database (AGENTS.md section 8).
///   - Single-use: consumption is recorded via `usedAt`.
///   - Expiry is enforced in the service layer against `expiresAt`.
///   - Provider-independent: no SMS provider is assumed; V1 delivery is
///     the gated local development log only. No paid provider.
model MobileVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  clientId  String    @db.Uuid
  // Audit only: which authenticated User requested this verification.
  // Nullable because a pre-binding onboarding verification has no bound
  // owner yet.
  requestedByUserId String? @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("MobileVerificationRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Client Operations V1 - METADATA ONLY (human-approved: see
// docs/APPROVED_DECISIONS.md, Decision 008).
//
// Governance:
//   - AGENTS.md §2   : V1 platforms are Instagram, Facebook, YouTube ONLY.
//   - AGENTS.md §13  : the Content module is an approved carve-out for THIS
//                      schema. APPROVED is the terminal Content state here;
//                      the Publishing engine remains deferred.
//   - AGENTS.md §8   : NO credential of any kind is stored by these models.
//                      OAuth, token storage, token encryption, platform API
//                      integration, and S3/object storage are explicitly OUT
//                      OF SCOPE for this phase. SocialAccount is metadata
//                      only: declared by the client/agency, never verified
//                      against the platform.
//   - AGENTS.md §6-§7: every model carries a non-nullable `clientId` and is
//                      always scoped server-side through the verified Client
//                      context. Client is the isolation boundary for this
//                      data; Organization (the Agency tenant) reaches it only
//                      through an ACTIVE ClientAgencyRelationship.
//   - AGENTS.md §11  : ContentRevision and the event logs are INSERT-ONLY.
// ---------------------------------------------------------------------------

/// V1 social platforms only (AGENTS.md §2). X and WhatsApp are out of scope
/// and must not be added without explicit human approval.
enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
}

/// Status machine for Content. Publishing is intentionally NOT reachable here
/// until the deferred Publishing engine is separately approved; APPROVED is
/// the terminal state for Client Operations V1. APPROVED is only reachable via
/// the Final Confirmation triple on Content, additionally enforced by a CHECK
/// constraint added in migration client_operations_v1_metadata.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  ARCHIVED
}

/// Provenance of raw intake material.
enum RawDataSource {
  CLIENT_UPLOAD
  CLIENT_FORM
  AGENCY_UPLOAD
  EXTERNAL_IMPORT
}

/// A social-media account recorded against exactly ONE Client.
///
/// SCOPE: METADATA ONLY. This model deliberately stores NO access token, NO
/// refresh token, NO password, and NO platform secret of any kind, and it
/// never calls a platform API. OAuth connection, token storage, token
/// encryption, and connector logic are deferred to a dedicated, separately
/// approved phase (AGENTS.md §13) that will also settle the encryption /
/// key-management question (§5.7). A future credential addition must be a
/// separate 1:1 table (e.g. SocialAccountCredential) rather than widening
/// this row, so the secret surface stays structurally separate.
///
/// Because nothing here is platform-verified, the stored values are DECLARED
/// BY THE CLIENT/AGENCY, NOT VERIFIED: field names are deliberately neutral
/// (`handle`, `profileUrl`) and no `isVerified` marker exists.
model SocialAccount {
  id        String         @id @default(uuid()) @db.Uuid
  /// Tenant key. Non-nullable: a SocialAccount can never exist outside a
  /// Client (AGENTS.md §6-§7 isolation).
  clientId  String         @db.Uuid
  platform  SocialPlatform

  /// Platform-side identifier (IG user id / FB page id / YT channel id).
  /// NULLABLE: without OAuth/API access this is often unknown, and a required
  /// value would force invented data. Postgres treats NULLs as distinct in a
  /// unique index, so several not-yet-identified accounts of the same platform
  /// may coexist; once an identifier is known it is unique per client.
  platformAccountId String?
  /// Non-secret presentation fields, client-supplied.
  handle            String?
  displayName       String?
  /// Human-checkable public reference (e.g. the profile URL). Never fetched
  /// or verified by the backend in this phase.
  profileUrl        String?

  /// Declarative enable/disable of the record (mirrors
  /// Organization.isActive / Workspace.isActive). Carries no OAuth meaning.
  isActive          Boolean  @default(true)

  /// Audit only (AGENTS.md §8: important operations are auditable).
  createdByUserId   String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client        Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("SocialAccountCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([clientId, platform, platformAccountId])
  @@index([clientId, platform])
  @@index([clientId, isActive])
}

/// The canonical "one story" for a Client. Formatting it into per-platform
/// variants belongs to the deferred Publishing/Distribution work (per-platform
/// variants are deliberately NOT modeled in this phase).
///
/// FINAL CONFIRMATION GATE: `status = APPROVED` is reachable ONLY by writing
/// finalConfirmedAt + finalConfirmedByUserId + finalConfirmedRevisionId
/// together, in one transaction, by an authorized confirmer (approved rule:
/// the CLIENT OWNER confirms). A future Publishing step must assert this
/// triple AND match the confirmed revision's contentHash. The database
/// additionally enforces the triple with a CHECK constraint
/// (Content_approved_requires_final_confirmation).
///
/// Approved rule (D7): editing an APPROVED item appends a new revision,
/// returns status to DRAFT, and CLEARS the confirmation triple in the same
/// transaction - approval can never be silently reused or invalidated.
model Content {
  id        String        @id @default(uuid()) @db.Uuid
  /// Tenant key. Non-nullable: Content can never exist outside a Client
  /// (AGENTS.md §6-§7 isolation).
  clientId  String        @db.Uuid
  title     String
  body      String
  status    ContentStatus @default(DRAFT)

  // --- Final Confirmation: the ONLY path to APPROVED ---------------------
  finalConfirmedAt         DateTime?
  finalConfirmedByUserId   String?   @db.Uuid
  /// Points at the immutable snapshot the confirmer actually approved.
  finalConfirmedRevisionId String?   @db.Uuid

  archivedAt      DateTime?
  /// Audit only (AGENTS.md §8).
  createdByUserId String?   @db.Uuid
  updatedByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client               Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser        User?                @relation("ContentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser        User?                @relation("ContentUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  finalConfirmedByUser User?                @relation("ContentFinalConfirmer", fields: [finalConfirmedByUserId], references: [id], onDelete: SetNull)
  revisions            ContentRevision[]
  statusEvents         ContentStatusEvent[]
  rawData              RawData[]

  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@index([finalConfirmedByUserId])
}

/// INSERT-ONLY snapshot of a Content body. Rows are never updated or deleted
/// (AGENTS.md §11 insert-only/immutable discipline; same pattern as the
/// ClientEvent audit trail). Editing produces a NEW revision.
///
/// This is what makes "approved text can never silently change" enforceable:
/// the Final Confirmation references a revision id, and the title/body/hash
/// live in an immutable row.
model ContentRevision {
  id        String @id @default(uuid()) @db.Uuid
  contentId String @db.Uuid
  /// Denormalized tenant key so revision queries stay client-scoped.
  clientId  String @db.Uuid
  revision  Int
  title     String
  body      String
  /// SHA-256 of (title + body): proves the confirmed text is unchanged.
  contentHash     String
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  content       Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("ContentRevisionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([contentId, revision])
  @@index([clientId, contentId])
}

/// APPEND-ONLY status-transition log (insert-only; rows are never updated or
/// deleted). Mirrors the ClientEvent audit pattern used by Client Module V1.
/// Every transition records who moved it, from/to, and why.
model ContentStatusEvent {
  id          String         @id @default(uuid()) @db.Uuid
  contentId   String         @db.Uuid
  /// Denormalized tenant key (tenant-scoped audit queries).
  clientId    String         @db.Uuid
  fromStatus  ContentStatus?
  toStatus    ContentStatus
  actorUserId String?        @db.Uuid
  /// Audit context, e.g. CLIENT | AGENCY_ADMIN | SOCIALOPS_ADMIN.
  actorRole   String?
  note        String?
  createdAt   DateTime       @default(now())

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorUser User?   @relation("ContentStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([contentId, createdAt])
}

/// Provenance record for raw intake material (the "permanent knowledge base"
/// seed). INSERT-ONLY in this phase: rows are never updated or deleted.
///
/// S3-compatible object storage is DEFERRED (AGENTS.md §13), so this phase
/// stores extracted text and/or structured metadata only; `storageRef` is
/// reserved for the later storage phase and must never hold a public URL.
model RawData {
  id               String        @id @default(uuid()) @db.Uuid
  /// Tenant key. Non-nullable: RawData can never exist outside a Client
  /// (AGENTS.md §6-§7 isolation).
  clientId         String        @db.Uuid
  source           RawDataSource
  /// Optional provenance link to the Content item this material fed.
  contentId        String?       @db.Uuid
  mimeType         String?
  originalFileName String?
  /// Extracted text. NULL when the payload is not text (storage deferred).
  extractedText    String?
  metadata         Json?
  /// SHA-256 of the captured payload (integrity + dedup).
  contentHash      String
  byteSize         Int?
  /// Reserved for the future S3-compatible storage phase. Never a public URL.
  storageRef       String?
  capturedAt       DateTime      @default(now())
  /// Audit only (AGENTS.md §8).
  capturedByUserId String?       @db.Uuid
  createdAt        DateTime      @default(now())

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content        Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  capturedByUser User?    @relation("RawDataCapturer", fields: [capturedByUserId], references: [id], onDelete: SetNull)

  @@index([clientId, capturedAt])
  @@index([clientId, source])
  @@index([contentId])
}

// ---------------------------------------------------------------------------
// Employee Module V1 (Phase 1, human-approved).
//
// Governance notes:
//   - EmployeeProfile is a 1:1 extension of User: `userId` is UNIQUE, so a
//     user has at most one profile.
//   - Deliberately NO organizationId (an employee profile is not an
//     OrganizationMembership) and NO ClientEmployee relation (not part of
//     Phase 1).
//   - AccountType remains exactly SERVICE_PROVIDER | INDIVIDUAL_BUSINESS
//     (AGENTS.md §17.1); employee registration is a separate future flow.
// ---------------------------------------------------------------------------

/// A 1:1 extension of the User record for employee accounts.
model EmployeeProfile {
  id        String   @id @default(uuid()) @db.Uuid
  // 1:1 with User: UNIQUE guarantees at most one profile per user.
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}