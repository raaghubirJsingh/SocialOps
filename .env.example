# SocialOps environment template
# ------------------------------
# Copy this file to the target location and fill in real values locally.
# NEVER commit real credentials of any kind (AGENTS.md section 8).
# This file is the git-committed safe template; placeholders only.

# API (apps/api) - NestJS server port (default in code: 4000)
PORT=4000

# ---------------------------------------------------------------------------
# Stage B foundation placeholders (reserved for future bootstrap work; unused)
# ---------------------------------------------------------------------------
# PostgreSQL connection string (Prisma will consume this in Stage B).
# User/password below are local dev placeholders - change them locally.
DATABASE_URL=postgresql://socialops:change-me@localhost:5432/socialops

# Redis connection URL (connection validation in Stage B)
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Stage B6 Authentication (JWT + Argon2id)
# ---------------------------------------------------------------------------
# JWT secrets must be strong, unique per environment, and stored securely.
# Access token TTL: 900 seconds (15 minutes) for short-lived sessions.
# Refresh token TTL: 604800 seconds (7 days) for persistent sessions.
# NEVER commit real JWT secrets; use environment-specific values only.
JWT_ACCESS_SECRET=change-me-use-a-strong-random-secret-32-chars
JWT_REFRESH_SECRET=change-me-use-a-strong-random-secret-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---------------------------------------------------------------------------
# Stage B7+ Email verification (development tooling)
# ---------------------------------------------------------------------------
# BOOT_ARTIFACTS_ALLOWED=true permits the backend to LOG verification URLs
# for LOCAL TESTING ONLY. No email provider is approved (no SendGrid/Resend/
# Mailgun/SMTP); actual production email delivery is explicitly deferred.
# Must be 'false' in any non-local environment. The frontend never displays
# the raw verification token.
BOOT_ARTIFACTS_ALLOWED=false
# Frontend base URL used to build email-verification links.
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stage B7+ Dev-only auto-verify registration bypass
# ---------------------------------------------------------------------------
# AUTH_DEV_AUTO_VERIFY_REGISTER=true short-circuits email verification for
# local development / automated testing. New users are created ACTIVE and
# with emailVerifiedAt already populated, no EmailVerificationToken row is
# issued, and the response is `status: 'registration_complete'` so the
# frontend navigates to /login. **DEVELOPMENT/TESTING ONLY.** A hard-stop in
# `apps/api/src/auth/dev-auto-verify.ts` forces the gate CLOSED whenever
# NODE_ENV='production' - so even if a deployment system accidentally
# carries the flag, the bypass stays off in production. Strict string
# match: only the literal 'true' opens the gate; '1', 'TRUE', 'yes', and
# whitespace variants are all treated as off. Must be 'false' in production.
AUTH_DEV_AUTO_VERIFY_REGISTER=false

# ---------------------------------------------------------------------------
# Local Docker services (docker-compose.yml)
# ---------------------------------------------------------------------------
# Password for the local development PostgreSQL container started by
# docker-compose.yml. The compose file reads it with ${POSTGRES_PASSWORD} and
# deliberately has NO default value, so `docker compose up` stops with a clear
# message until it is set. Put the real value in the ignored root .env file --
# never in a tracked file (AGENTS.md section 8).
# This value is a placeholder only.
POSTGRES_PASSWORD=change-me-local-dev-only
