# Dependencies
node_modules/

# Build output
dist/
.next/
build/
out/
*.tsbuildinfo

# Environment / secrets (AGENTS.md section 8)
# Never commit real credentials. .env.example is the safe template and is preserved.
.env
.env.*
!.env.example

# Testing / coverage
coverage/
coverage.*.json
*.lcov

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Misc
.cache/
.tmp/

# SocialOps dev scratch / output dumps (keep these out of the tree)
*_output.txt
*-output.txt
.runtime-*
test-results/
prisma-*-output.sql

# ---------------------------------------------------------------------------
# Local-only agent tooling and scratch runners.
# Mirrors the existing .vscode/ and .idea/ exclusions: local configuration and
# throwaway runners must never enter history (AGENTS.md section 8 - no
# credentials in Git, in any form).
#
# `.clinerules/`        - local Cline agent rules (AGENTS.md is the binding
#                         governance contract, so a second rule source is not
#                         committed).
# `tools/supervisor/`   - observe-only Supervisor WIP tooling. The Supervisor
#                         stage is NOT an approved module yet; promoting this
#                         tooling is a separate, explicitly approved step
#                         (see docs/AI-WORKFLOW.md).
# `*itest*.ps1`         - local integration-runner scratch scripts, which
#                         previously embedded database credentials. Use
#                         `npm run test:integration --workspace=apps/api`
#                         instead; prefer ignored *.env files for values.
# ---------------------------------------------------------------------------
.clinerules/
tools/supervisor/
*itest*.ps1
